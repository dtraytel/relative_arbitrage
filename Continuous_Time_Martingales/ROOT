session Continuous_Time_Martingales = "HOL-Probability" +
  description "
    What continuous-time martingale theory needs beyond the AFP's
    Martingales entry: Doob's maximal inequality, optional sampling and
    stopping at a bounded stopping time, quadratic variation and its
    compensator, Vitali's theorem, exit times as stopping times, and the
    algebra of transporting the martingale property along images, products,
    restrictions and modifications.
  "
  options [document = pdf, document_output = "output"]
  sessions
    Martingales
  theories
    Power_Inequalities
    Quadratic_Variation
    Time_Discretisation
    Doob_Inequality
    Optional_Sampling
    Stopped_Adaptedness
    Sampled_Martingale
    Sampled_Quadratic_Variation
    Moment_Bounds
    Vitali_Convergence
    Modification_Transfer
    Stopping_Times
    Natural_Filtration
    Semidirect_Kernels
    Martingale_Algebra
    Integrability_Criteria
    Martingale_Transfer
  document_files
    "root.tex"
    "root.bib"
