session Symmetric_Matrix_Spectra = "HOL-Analysis" +
  description "
    The spectral theory of real symmetric matrices that HOL-Analysis stops
    short of -- a trace and transpose calculus, orthonormal families and
    the orthogonal projections onto them, Householder reflections and
    rotations, the spectral theorem, Ky Fan partial sums, the ordered
    eigenvalues as their differences, their Lipschitz dependence on the
    matrix, and Poincare separation -- for anyone
    who constrains a matrix through its spectrum rather than through its
    entries.
  "
  options [document = pdf, document_output = "output"]
  theories
    Matrix_Algebra
    Outer_Products
    Orthonormal_Families
    Orthogonal_Projections
    Symmetric_Spectral
    Ky_Fan
    Eigenvalue_Continuity
    Poincare_Separation
    Householder_Rotation
  document_files
    "root.tex"
    "root.bib"
