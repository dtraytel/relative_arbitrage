session Semicontinuous_Analysis = "HOL-Probability" +
  description "
    Upper and lower semicontinuity for real-valued functions on a metric
    space: the epsilon-delta calculus, attainment on compacta, bounded
    extension off a closed set, the semicontinuous envelopes over the whole
    space and relative to a closed set, and Berge's maximum theorem.  The
    envelope is the lower semicontinuous hull of the Lower_Semicontinuous
    entry, proved equal to it rather than reproved.
  "
  options [document = pdf, document_output = "output"]
  sessions
    Standard_Borel_Spaces
    Lower_Semicontinuous
  theories
    Semicontinuity
    Semicontinuous_Envelopes
    Berge
  document_files
    "root.tex"
    "root.bib"
